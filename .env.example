# ChatLustora Environment Configuration
# Target Domain: ChatLustora.com

# PORT: The port the backend server listens on (defaults to 3000)
PORT=3000

# NODE_ENV: 'development' or 'production'
NODE_ENV=development

# APP_URL: Production canonical URL
APP_URL=https://chatlustora.com

# SUPABASE POSTGRESQL & STORAGE (Optional - fallback in-memory store operates if omitted)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# STUN / TURN WEBRTC CONFIGURATION
# Default uses public Google STUN servers (stun.l.google.com:19302).
# For production environments behind symmetric NATs, provide TURN credentials:
# TURN_URL=turn:turn.chatlustora.com:3478
# TURN_USERNAME=chatlustora_user
# TURN_CREDENTIAL=turn_secret_token

# MODERATOR SECRET PASSKEY (For testing moderation triage)
MODERATOR_KEY=lustora-mod-2026
